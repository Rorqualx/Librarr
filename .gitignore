## Merge any idea folder
*/**/.idea
*.iml

# API doc generation
.config/

# Benchmark-script OL response cache (scripts/bench_le_guin.py)
scripts/.bench-cache/

# Claude Code runtime artifacts. NOT a blanket `.claude/` ignore: 17 files
# under .claude/ (hooks/, settings.json) are deliberately tracked and shared,
# and a blanket rule silently hides any newly added hook from `git status`.
# Runtime droppings are already handled by .claude/.gitignore.
.claude/**/__pycache__/
.claude/**/*.pyc
.claude/*.lock

# ── Librarr additions ───────────────────────────────────────────────

# Docker Compose bind-mount targets (docker-compose.yml). These hold a live
# install: readarr.db, logs.db, Sentry/, the PID file, plus whatever library
# and download paths get pointed at them. Never committable.
docker-config/
docker-books/
docker-downloads/

# Local smoke-test data dir. config.xml inside it was already caught by the
# global `config.xml` rule, but cache.db/logs.db etc. were not.
_smoke-config/

# Release staging tree built by .github/workflows/release.yml (tarballs,
# zips, SHA256SUMS). `_artifacts` above is the per-RID package dir.
_release/

# Test droppings not covered above (`*log.txt` is case-sensitive and misses
# TestLog.txt; coverage*.xml misses the CoverageResults/ directory).
CoverageResults/
TestLog.txt
*.trx

# Outreach working notes. Deliberately untracked: they aggregate ~96 named
# GitHub users into a tiered contact list plus drafted messages. The source
# threads are public, but republishing a targeting list of named individuals
# in the project repo is a different thing, and none of it is needed to build
# or run Librarr. Keep them local.
OUTREACH.md
OUTREACH-*.md

# Secrets / local overrides. Broad on purpose — an operator dropping a .env
# next to docker-compose.yml is the likeliest way credentials leak into a
# commit here.
.env
.env.*
*.env
*.local
!*.local.example

# Editor dirs the inherited rules only cover when nested
# (`*/**/.idea` misses a repo-root .idea/). No `.vscode/` rule on purpose —
# extensions.json / launch.json / tasks.json there are tracked and shared.
.idea/
*.swp
*.swo

# Python bytecode from scripts/*.py
__pycache__/
