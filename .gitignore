# Visual Studio version. Backup files are not needed, because we have git ;-)
_UpgradeReport_Files/
UpgradeLog*.XML

# SQL Server files
App_Data/*.mdf
App_Data/*.ldf

# Git Files
*.orig

# Tools
_NCrunch_*
_TeamCity*

