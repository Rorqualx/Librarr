<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- app.manifest asks for requireAdministrator. Nothing referenced it, so
         it was never embedded: double-clicking the helper ran it unelevated,
         it printed "Access denied" to a console a WinExe does not have, and
         exited having done nothing. The icon was orphaned the same way. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>red_puzzle.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
